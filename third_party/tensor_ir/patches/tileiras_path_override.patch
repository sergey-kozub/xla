+/// The assembler installed with setTileIRAssembler().
+struct AssemblerOverride {
+  std::string path;
+  std::vector<std::string> environment;
+};
+
+/// Guards assemblerOverride(). Hosts install the override once during start-up
+/// but may assemble from several threads afterwards.
+std::mutex &assemblerOverrideMutex() {
+  static std::mutex *mutex = new std::mutex();
+  return *mutex;
+}
+
+AssemblerOverride &assemblerOverride() {
+  static AssemblerOverride *override = new AssemblerOverride();
+  return *override;
+}
+
+AssemblerOverride getAssemblerOverride() {
+  std::lock_guard<std::mutex> lock(assemblerOverrideMutex());
+  return assemblerOverride();
+}
